// POI Capture cloud as a Cloudflare Worker (../README.md, "Cloudflare Worker").
// Secrets (not here): ADMIN_TOKEN, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (`npx wrangler secret put <NAME>`). Locally: .dev.vars (git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poi-capture-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "poi-capture-uploads" }],
  "durable_objects": { "bindings": [{ "name": "UPLOADS", "class_name": "Uploads" }] },
  // the free plan needs SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Uploads"] }],
  // daily: remove unfinished uploads untouched for EXPIRE_DAYS (and their R2 parts)
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // the reviewer web app: local dev servers and Cloudflare Pages (production + preview deployments)
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5199,https://poi-capture-reviewer.pages.dev,https://*.poi-capture-reviewer.pages.dev",
    "BASE_PATH": "/files",
    "MAX_SIZE": "4294967296",
    "EXPIRE_DAYS": "7",
    // direct uploads (README "Direct uploads"); secrets R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY: an R2 API token
    // with Object Read & Write on this bucket
    "R2_ACCOUNT_ID": "4e48e295fbbb6bed3f3975df76345d02",
    "R2_BUCKET": "poi-capture-uploads"
  }
}
