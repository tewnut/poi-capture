<?xml version="1.0" encoding="utf-8"?>
<!-- Everything stays HTTPS-only (the platform default) except the Ricoh Theta's own address on its Wi-Fi: the OSC API
     is plain HTTP there (docs/camera360.md §4). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>
</network-security-config>
