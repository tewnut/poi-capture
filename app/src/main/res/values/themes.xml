<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme (Compose draws everything; this only sets the window). -->
    <style name="Theme.PoiCapture" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!-- Splash screen: the logo on the app's green while the app starts, then the app theme. -->
    <style name="Theme.PoiCapture.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PoiCapture</item>
    </style>
</resources>
